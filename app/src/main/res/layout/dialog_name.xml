<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@drawable/card_gradient"
    android:orientation="vertical"
    android:padding="24dp"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/nameDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="شروع قوی از همین‌جا 🔥"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="می‌خوام از این به بعد با اسم خودت صدات کنم."
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/input_bg"
        android:hint="مثلاً علی"
        android:inputType="textCapWords"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="#62708C"
        android:textSize="16sp" />

    <Button
        android:id="@+id/saveNameButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/primary"
        android:text="بزن بریم 🚀"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
