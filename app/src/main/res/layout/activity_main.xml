<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سلام، قهرمان 👋"
                    android:textColor="@color/white"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="امروز قراره یک درصد بهتر بشی."
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/editNameButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="#19233C"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="پروفایل ✏️"
                android:textColor="#DCE5FF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_purple"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 رکورد فعلی"
                    android:textColor="#EFEAFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/streakValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="روز پاکی"
                    android:textColor="#EFEAFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/card_green"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆 بهترین"
                    android:textColor="#E9FFFA"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/bestValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بهترین رکورد"
                    android:textColor="#E9FFFA"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/card_orange"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ سطح"
                    android:textColor="#FFF6E5"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/levelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LVL 1"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/xpValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 XP"
                    android:textColor="#FFF6E5"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_gradient"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 مأموریت امروز"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="منتظر انگیزه نباش؛ یک کار کوچک را همین امروز انجام بده و امتیاز بگیر."
                android:textColor="@color/muted"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/todayScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:text="0%"
                android:textColor="@color/secondary"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cleanCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_red"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔥 امروز پاک بودم"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/cleanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="امروز را ثبت کن"
                android:textColor="#FFE9EC"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/workoutCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_green"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💪 تمرین امروز"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/workoutStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="۲۰ دقیقه حرکت"
                android:textColor="#E8FFFA"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/worshipCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_purple"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤲 وقت نزدیک‌شدن"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/worshipStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="نماز + قرآن + ذکر"
                android:textColor="#F0ECFF"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/reportButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/secondary"
            android:text="گزارش امروز را ثبت کن →"
            android:textColor="#071815"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notificationHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_gradient"
            android:clickable="true"
            android:gravity="center"
            android:padding="15dp"
            android:text="🔔 یادآوری روزانه ساعت ۲۰:۰۰ فعال می‌شود — برای اجازه اعلان لمس کن"
            android:textColor="#C8D2EA"
            android:textSize="12sp" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:backgroundTint="#172139"
            android:minWidth="0dp"
            android:text="ریست رکورد"
            android:textColor="#FFB5BE"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="بدون سرزنش • فقط پیشرفت • هر روز یک قدم"
            android:textColor="#60708C"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
